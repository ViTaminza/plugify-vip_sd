{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_SD_VERSION}",
	"name": "vip_sd",
	"description": "[VIP] Show Damage: prints the damage an attacker dealt to the attacker's screen centre (player_hurt), for VIPs whose 'show_damage' feature is on and when the victim is on another team. Ported from the Pisex VIP core module VIP_ShowDamage (vip_sd). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_sd",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
